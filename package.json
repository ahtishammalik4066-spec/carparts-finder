{
  "name": "partfinder",
  "version": "0.1.0",
  "private": true,
  "description": "PartFinder PK - Automotive Spare Parts Marketplace / Supplier Matching Platform",
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/dashboard",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:dashboard": "npm run dev --workspace apps/dashboard",
    "build:web": "npm run build --workspace apps/web",
    "build:api": "npm run build --workspace apps/api",
    "build:dashboard": "npm run build --workspace apps/dashboard",
    "build:shared": "npm run build --workspace packages/shared"
  }
}